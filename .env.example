# Free default stack: Groq (chat) + FastEmbed (local embeddings) + Pinecone free tier
GROQ_API_KEY=gsk_...
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=energy-deal-rag
LLM_PROVIDER=groq
CHAT_MODEL=openai/gpt-oss-120b
EMBED_PROVIDER=fastembed

# Optional paid alternative: set LLM_PROVIDER=openai, EMBED_PROVIDER=openai,
# CHAT_MODEL=gpt-4o-mini and add OPENAI_API_KEY=sk-...
